# Discord integration - copy to .env and fill in. Secrets are env-only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/discord/callback/
DISCORD_GUILD_ID=
# Comma-separated versioned bot keys (e.g. key_v1_...,key_v2_...). Add a new
# version to rotate without downtime; remove the old one after the bot redeploys.
DISCORD_BOT_API_KEYS=
DISCORD_TICKET_API_ALLOW_PUBLISHER_FALLBACK=False
